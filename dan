# License: ISC

# TODO: 
# - when applying, grep the directory path before the last dir or file. Then mkdir -p them. This to fix fail when applying because there's no path for copying.
# - when init, if the directory already have .dan files, do not attempt to create again. Instead tell you if it's an existing dan directory, and you can apply from there.

# Variables
OPTION="$1"
shift # shift arguments so $@ only contains the choices
CHOICE=("$@")

setup() {
	config_file="$HOME/.config/dan/config"
	config_dirs="${config_file%/*}"

	mkdir -p "$config_dirs"
	[[ ! -f "$config_file" ]] && touch "$config_file"
}

load_config() {
	dotfiles_path=$(<"$config_file")
	dotfiles_path="${dotfiles_path##path = }"
	dotfiles_path="${dotfiles_path/\~/$HOME}"
	entry_file="$dotfiles_path/.dan"

	[[ -n "$dotfiles_path" ]] # returns 0 if not empty, 1 if empty
}

confirmation() {
	TEXT="$1"; CONF_TEXT="$2"

	if [[ -z "$CONF_TEXT" ]]; then
		read -p "$TEXT [Y/n] " answer
	else
		echo -e "$TEXT"
		read -p "$CONF_TEXT [Y/n] " answer
	fi

	case $answer in
		n | N) echo "Exitted." && exit 1 ;;
		*) return 0;;
	esac
}

get_entry_path() {
	local TARGET=$1

	local path="$(grep "$TARGET" "$entry_file")"
	if [[ -n "$path" ]]; then
		CHOICE_RAW="$path"
		CHOICE_PATH="${path##* = }"
		CHOICE_PATH="${CHOICE_PATH/\~/$HOME}"
		CHOICE_NAME="${CHOICE_PATH##*/}"
		CHOICE_DOTS="$dotfiles_path/$CHOICE_NAME"
		return 0
	else
		return 1
	fi
}

get_choice_path() {
	local TARGET=$1

	CHOICE_PATH="$(realpath $TARGET)"
	[[ -z "$CHOICE_PATH" ]] && echo "failed: not a real path" && exit 1

	TILDE_PATH="${CHOICE_PATH/$HOME/\~}"
	CHOICE_NAME="${CHOICE_PATH##*/}"
	CHOICE_DOTS="$dotfiles_path/$CHOICE_NAME"
}

get_current_path() {
	current_dir="$PWD"
	[[ -z "$current_dir" ]] && echo "failed: get current working directory" && exit 1
	TILDE_PATH="${current_dir/$HOME/\~}"
}

add_path_to_entry() {
	if ! grep -q "$CHOICE_NAME" "$entry_file"; then
		echo "$CHOICE_NAME = $TILDE_PATH" >> "$entry_file" && echo "success: add path to entry" || echo "failed: add path to entry"
	fi
}

init() {
	if [[ ${#CHOICE[@]} -eq 0 ]]; then
		get_current_path
	else
		get_choice_path "${CHOICE}"
	fi

	if load_config; then
		confirmation "You will overwrite the dotfiles path from '$dotfiles_path' into '$TILDE_PATH'" "Proceed to overwrite?"
		touch "$entry_file"
		echo "path = $TILDE_PATH" > "$config_file" && echo "success: overwrite dotfiles path" || echo "failed: overwrite dotfiles path" && exit 1
	else
		confirmation "You will set the dotfiles path into '$TILDE_PATH'" "Proceed to apply?"
		touch "$entry_file"
		echo "path = $TILDE_PATH" > "$config_file" && echo "success: set dotfiles path" || echo "failed: set dotfiles path" && exit 1
	fi
}

sync() {
	if ! load_config; then echo "error: no dotfiles path" && exit 1; fi

	if [[ ${#CHOICE[@]} -eq 0 ]]; then
		confirmation "You will replace all the folders or files on dotfiles with the local" "Proceed to syncall?"
		while IFS=" = " read -r pkgs path; do
			path="${path/\~/$HOME}"
			[[ -e "$dotfiles_path/$pkgs" ]] && rm -rf "$dotfiles_path/$pkgs"
			cp -rf "$path" "$dotfiles_path/$pkgs" && echo "success: copy $pkgs" || echo "failed: copy $pkgs"
		done < "$entry_file"
	else
		confirmation "Sync $CHOICE_NAME into the dotfiles" "Proceed to sync?"
		for pkg in "${CHOICE[@]}"; do
			if get_entry_path "$pkg"; then 
				[[ -e "$CHOICE_DOTS" ]] && rm -rf "$CHOICE_DOTS"
				cp -rf "$CHOICE_PATH" "$CHOICE_DOTS" && echo "success: copy $CHOICE_NAME" || echo "failed: copy $CHOICE_NAME"
			elif get_choice_path "$pkg"; then
				[[ -e "$CHOICE_DOTS" ]] && rm -rf "$CHOICE_DOTS"
				cp -rf "$CHOICE_PATH" "$CHOICE_DOTS" && echo "success: copy $CHOICE_NAME" || echo "failed: copy $CHOICE_NAME"
				add_path_to_entry 
			fi
		done
	fi
}

apply() {
	if ! load_config; then echo "error: no dotfiles path" && exit 1; fi

	if [[ ${#CHOICE[@]} -eq 0 ]]; then
		confirmation "You will replace all the folders or files on local with the dotfiles" "Proceed to applyall?"
		while IFS=" = " read -r pkgs path; do
			path="${path/\~/$HOME}"
			[[ -e "$path" ]] && rm -rf "$path"
			cp -rf "$dotfiles_path/$pkgs" "$path" && echo "success: apply $pkgs" || echo "failed: apply $pkgs"
		done < "$entry_file"
	else
		confirmation "Apply $CHOICE_NAME into local" "Proceed to apply?"
		for pkg in "${CHOICE[@]}"; do
			if get_entry_path "$pkg"; then
				[[ -e "$CHOICE_PATH" ]] && rm -rf "$CHOICE_PATH"
				cp -rf "$CHOICE_DOTS" "$CHOICE_PATH" && echo "success: apply $CHOICE_NAME" || echo "failed: apply $CHOICE_NAME"
			else
				echo "error: $pkg not found in entry list"
			fi
		done
	fi
}

remove() {
	if ! load_config; then echo "error: no dotfiles path" && exit 1; fi

	if [[ ${#CHOICE[@]} -eq 0 ]]; then
		echo "error: no targets specified (use 'dan help' for help)" && exit 1
	else
		confirmation "Are you sure to delete $CHOICE_NAME" "Proceed to remove?"
		for pkg in "${CHOICE[@]}"; do
			if get_entry_path "$pkg"; then
				[[ -e "$CHOICE_DOTS" ]] && rm -rf "$CHOICE_DOTS"

				while read -r line; do
					if [[ "$line" != "$CHOICE_RAW" ]]; then
						echo "$line"
					fi
				done < "$entry_file" > "$entry_file.tmp"
				mv "$entry_file.tmp" "$entry_file" && echo "success: remove $CHOICE_NAME" || echo "failed: remove $CHOICE_NAME"
			else
				echo "error: $pkg not found in entry list"
			fi
		done
	fi
}

helps() {
	cat <<- HELP
		usage: dan [-v | --version] [-h | --help]
		           <command> [<args>]

		commands (with arguments)
		   help		show the help page
		   list		show existing things inside dotfiles
		   init		create a dan directory
		   sync		add specified things into dotfiles
		   apply	apply specified folder into local
		   remove	remove things from dotfiles

		commands (without arguments)
		   sync		sync all from the list on dotfiles
		   apply	apply all from the list on dotfiles

		'dan help' or 'dan -h' shows this page.
	HELP
}

list() {
	load_config 
	DISTANCE=30;
	BLUE="\033[1;34m"
	BLCK="\033[0;30m"
	NONE="\033[0m"

	printf "${BLCK}##${NONE}[${BLUE}dan${NONE}] $dotfiles_path\n"

	while IFS=" = " read -r pkgs path; do
		path="${path/\~/$HOME}"
		if [[ -d "$path" ]]; then
			printf "${BLCK}-- ${BLUE} "
			printf "$(printf "%-${DISTANCE}s" "$pkgs")$NONE\n"
		elif [[ -f "$path" ]]; then
			printf "${BLCK}-- ${NONE} "
			printf "$(printf "%-${DISTANCE}s" "$pkgs")\n"
		else
			echo "there's nothing in your dotfiles($dotfiles_path)."
		fi
	done < "$entry_file"
}

version() {
	cat <<- VER
		Dan v1.0.0 - bash
		Copyright (C) 2025-2026 @Pointers

		This program may be freely redistributed under
		the terms of the ISC License.
	VER
}

# Run
setup
case $OPTION in
	help) helps ;;
	list) list ;;
	init) init ;;
	sync) sync ;;
	apply) apply ;;
	remove) remove ;;
	version) version ;;
	*) helps ;;
esac
